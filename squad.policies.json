[
  {
    "id": "oracle-database",
    "effect": "allow",
    "principal": "oracle",
    "capability": "database",
    "operations": [
      "schema",
      "migration",
      "query",
      "seed"
    ]
  },
  {
    "id": "destructive-migration-founder-gate",
    "effect": "approval-required",
    "capability": "database",
    "operations": [
      "destructive-migration"
    ]
  },
  {
    "id": "disruptor-git",
    "effect": "allow",
    "principal": "disruptor",
    "capability": "git",
    "operations": [
      "branch",
      "commit",
      "push",
      "merge"
    ]
  },
  {
    "id": "no-direct-push-main",
    "effect": "deny",
    "capability": "git",
    "operations": [
      "push",
      "commit",
      "merge",
      "force-push",
      "delete-remote-branch"
    ],
    "resources": [
      "refs/heads/main",
      "refs/heads/master"
    ],
    "project": "spectree-squad"
  },
  {
    "id": "destructive-git-founder-gate",
    "effect": "approval-required",
    "capability": "git",
    "operations": [
      "force-push",
      "delete-remote-branch"
    ]
  },
  {
    "id": "disruptor-github",
    "effect": "allow",
    "principal": "disruptor",
    "capability": "github",
    "operations": [
      "pr",
      "ci",
      "release",
      "label"
    ]
  },
  {
    "id": "invoker-artifact-approval",
    "effect": "allow",
    "principal": "invoker",
    "capability": "artifact-status",
    "operations": [
      "approve",
      "done"
    ]
  },
  {
    "id": "jakiro-story-in-progress",
    "effect": "allow",
    "principal": "jakiro",
    "capability": "artifact-status",
    "operations": [
      "in-progress"
    ],
    "resources": [
      "docs/stories/*"
    ]
  },
  {
    "id": "filesystem-outside-workspace-deny",
    "effect": "deny",
    "capability": "filesystem",
    "operations": [
      "recursive-delete"
    ],
    "resources": [
      "outside-workspace"
    ]
  },
  {
    "id": "keeper-edit-scope",
    "effect": "allow",
    "principal": "keeper-of-the-light",
    "capability": "artifact-edit",
    "operations": [
      "edit"
    ],
    "resources": [
      "docs/stories/*",
      "docs/LESSONS.md"
    ]
  },
  {
    "id": "credential-founder-gate",
    "effect": "approval-required",
    "capability": "filesystem",
    "operations": [
      "read"
    ],
    "resources": [
      "credential/*"
    ]
  }
]
